# ----------------------------------------------------------------------------
# Fresh Solutions — environment variables template
# Copy to .env.local for development. Set the same variables in Vercel for
# production. NEVER commit real secrets to Git.
# ----------------------------------------------------------------------------

# --- Site URL (used for canonical URLs, sitemap, OG metadata, emails) -------
# Leave unset in local dev (defaults to http://localhost:3000).
# On Vercel, set it to your final URL, e.g. https://fresh-solutions.vercel.app
SITE_URL=

# --- Database ----------------------------------------------------------------
# Production: managed PostgreSQL (e.g. Supabase, Neon) connection string.
#   DATABASE_URL=postgres://user:password@host:5432/dbname
# Development: leave EMPTY to use the embedded Postgres engine (PGlite),
#   which stores data in ./.data/pg — real Postgres, no external service.
DATABASE_URL=

# Optional: directory for embedded dev database / local storage (default .data)
LOCAL_DATA_DIR=

# --- Initial administrator provisioning (used by scripts/provision-admin.ts) -
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Email (SMTP transactional email, e.g. Resend/SMTP2GO/Brevo/SES) ---------
# If unset, email sending is disabled and the app reports "not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fresh Solutions <no-reply@example.com>"
# Where admin notification emails are sent (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=

# --- Private/public file storage ---------------------------------------------
# Development: leave unset to store files on local disk under ./.data/storage
#   (served through authorised routes; fine for dev, NOT permanent on Vercel).
# Production: configure an S3-compatible bucket (Supabase Storage, AWS S3,
#   Cloudflare R2...). Files are served only via short-lived signed URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
# Set to "true" for Supabase Storage / MinIO style path-addressing
S3_FORCE_PATH_STYLE=true

# --- File access signing ------------------------------------------------------
# Secret used to sign short-lived download URLs when local storage is used.
# Generate with: openssl rand -hex 32   (optional in dev, autogenerated locally)
FILE_TOKEN_SECRET=

# --- Session behaviour --------------------------------------------------------
# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12
